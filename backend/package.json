{
  "name": "tiksave-backend",
  "version": "1.0.0",
  "description": "Backend API for TikSave - TikTok video organizer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun dist/index.js",
    "migrate": "bun src/database/migrate.ts",
    "seed": "bun src/database/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "bun test ./src/tests",
    "test:unit": "bun test ./src/tests/unit",
    "test:scenarios": "bun test ./src/tests/scenarios",
    "test:integration": "bun test ./src/tests/auth.test.ts ./src/tests/items.test.ts ./src/tests/folders.test.ts ./src/tests/search.test.ts",
    "test:mega": "bun test ./src/tests/unit/mega.suite.test.ts ./src/tests/unit/mega2.suite.test.ts",
    "test:watch": "bun test --watch ./src/tests",
    "test:coverage": "bun test --coverage ./src/tests",
    "test:auth": "bun test ./src/tests/auth.test.ts",
    "test:items": "bun test ./src/tests/items.test.ts",
    "test:folders": "bun test ./src/tests/folders.test.ts",
    "test:search": "bun test ./src/tests/search.test.ts",
    "test:security": "bun test ./src/tests/security",
    "test:security:fast": "bun test ./src/tests/security/01-ssrf.spoof.matrix.test.ts ./src/tests/security/02-xss.injection.matrix.test.ts ./src/tests/security/04-secrets.settings.matrix.test.ts ./src/tests/security/07-mega.security.suite.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/storage-blob": "^12.17.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.24.0",
    "pg": "^8.11.3",
    "pgvector": "^0.1.8",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}
